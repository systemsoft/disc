{
  "excludes": ["vendor/**"],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.0.wasm",
    "https://plugins.dprint.dev/json-0.21.3.wasm",
    "https://plugins.dprint.dev/markdown-0.21.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm"
  ],
  "typescript": {
    "arrowFunction.useParentheses": "preferNone",
    "bracePosition": "sameLine",
    "enumDeclaration.memberSpacing": "newLine",
    "exportDeclaration.sortNamedExports": "caseInsensitive",
    "exportDeclaration.sortTypeOnlyExports": "last",
    "importDeclaration.sortNamedImports": "caseInsensitive",
    "importDeclaration.sortTypeOnlyImports": "last",
    "indentWidth": 2,
    "lineWidth": 160,
    "memberExpression.linePerExpression": true,
    "module.sortExportDeclarations": "maintain",
    "module.sortImportDeclarations": "maintain",
    "nextControlFlowPosition": "sameLine",
    "newLineKind": "lf",
    "operatorPosition": "sameLine",
    "preferHanging": false,
    "preferSingleLine": false,
    "quoteProps": "asNeeded",
    "quoteStyle": "alwaysDouble",
    "semiColons": "always",
    "singleBodyPosition": "nextLine",
    "spaceAround": false,
    "spaceSurroundingProperties": true,
    "switchCase.bracePosition": "sameLine",
    "switchStatement.bracePosition": "sameLine",
    "trailingCommas": "never",
    "useBraces": "maintain",
    "useTabs": false
  }
}
