{
  "dependencies": {
    "@codemirror/lang-sql": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.2",
    "codemirror": "^6.0.1",
    "svelte-codemirror-editor": "^1.3.0"
  },
  "description": "Admin UI for Disc Database",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-static": "^3.0.1",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@testing-library/svelte": "^4.0.5",
    "@types/node": "^20.0.0",
    "@vitest/ui": "^1.0.0",
    "jsdom": "^23.0.0",
    "sass": "^1.69.5",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.0",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.3",
    "vitest": "^1.0.0"
  },
  "name": "@disc/ui",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "preview": "vite preview",
    "test": "vitest --config vite.config.test.ts --run --passWithNoTests",
    "test:coverage": "vitest --config vite.config.test.ts --run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "test:ui": "vitest --config vite.config.test.ts --ui",
    "test:watch": "vitest --config vite.config.test.ts"
  },
  "type": "module",
  "version": "0.1.0"
}
