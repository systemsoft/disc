{
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@inc/uchu": "^3.0.0",
    "codemirror": "^6.0.2",
    "svelte-codemirror-editor": "^2.1.0"
  },
  "description": "Admin UI for Disc Database",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.5.1",
    "@vitest/ui": "^5.0.0",
    "jsdom": "^30.0.1",
    "sass": "^1.104.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "name": "@disc/ui",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "preview": "vite preview",
    "test": "vitest --config vite.config.test.ts --run --passWithNoTests",
    "test:coverage": "vitest --config vite.config.test.ts --run --coverage --passWithNoTests",
    "test:dependencies": "bun update --latest",
    "test:e2e": "playwright test",
    "test:ui": "vitest --config vite.config.test.ts --ui",
    "test:watch": "vitest --config vite.config.test.ts"
  },
  "type": "module",
  "version": "0.1.0"
}
