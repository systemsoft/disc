{
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@inc/uchu": "^2.2.0",
    "codemirror": "^6.0.2",
    "svelte-codemirror-editor": "^2.1.0"
  },
  "description": "Admin UI for Disc Database",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^25.8.0",
    "@vitest/ui": "^4.1.6",
    "jsdom": "^29.1.1",
    "sass": "^1.99.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.8",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "name": "@disc/ui",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "preview": "vite preview",
    "test": "vitest --config vite.config.test.ts --run --passWithNoTests",
    "test:coverage": "vitest --config vite.config.test.ts --run --coverage --passWithNoTests",
    "test:dependencies": "bun update --latest",
    "test:e2e": "playwright test",
    "test:ui": "vitest --config vite.config.test.ts --ui",
    "test:watch": "vitest --config vite.config.test.ts"
  },
  "type": "module",
  "version": "0.1.0"
}
