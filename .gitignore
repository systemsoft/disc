thoughts/

# Compiled binaries at repo root (produced by `disc build` / `deno compile`)
/disc
/disc-linux-*
/disc-darwin-*

# Auto-generated embedded-PG manifest (regenerated by `cli/build.ts` on
# every build; paths shift between local `~/.disc/postgres/...` and
# cross-platform `dist/embedded-pg/<platform>/...` staging dirs).
# `deno task prep` writes an empty stub so the codebase type-checks
# without a full build.
/postgres/embedded-pg-manifest.ts

# Stray project scaffolds from interactive testing (see thoughts/shared/audits)
/disc.toml
/test-audit/
/w07/

# UI toolchain build output (Bun + Vite)
/ui/.svelte-kit/
/ui/build/
/ui/node_modules/
# NOTE: ui/bun.lock IS committed (P1-27) so CI and contributors get
# deterministic installs. Only the transient build outputs above are
# ignored.

# Playwright test artifacts (traces, videos, screenshots)
/ui/test-results/
/ui/playwright-report/
/ui/blob-report/

# Gel-compat smoke (P2-09) — generated cert + transient install dirs
/tests/gel-compat/.tls/
/tests/gel-compat/disc-serve.pid
/tests/gel-compat/python/.venv/
/tests/gel-compat/node/node_modules/
/tests/gel-compat/node/package-lock.json

# Python cache
__pycache__/
