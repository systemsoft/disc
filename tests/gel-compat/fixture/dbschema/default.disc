module default {
  type Item {
    required name: str;
    required count: int32;
    createdAt: datetime {
      default := datetime_current();
    };
    index on (.name);
  };

  type Label {
    required code: str {
      constraint exclusive;
    };
  };

  type Book {
    required title: str;
    multi tags: str;
  };

  type Author {
    required name: str;
    multi books: Book;
    best: Book;
  };
};
