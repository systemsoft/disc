{
  "compilerOptions": {
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true
  },
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli/mod.ts",
    "./compiler": "./compiler/mod.ts",
    "./edgeql": "./edgeql/mod.ts",
    "./schema": "./schema/mod.ts",
    "./sdk": "./sdk/mod.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.8",
    "@std/async": "jsr:@std/async@1.0.8",
    "@std/cli": "jsr:@std/cli@1.0.8",
    "@std/crypto": "jsr:@std/crypto@^1.0.5",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/fs": "jsr:@std/fs@1.0.8",
    "@std/http": "jsr:@std/http@1.0.8",
    "@std/io": "jsr:@std/io@^0.225.3",
    "@std/log": "jsr:@std/log@0.224.10",
    "@std/path": "jsr:@std/path@1.0.8",
    "@std/testing": "jsr:@std/testing@1.0.8"
  },
  "lint": {
    "exclude": ["reference-gel/**", "tests/fixtures/**"],
    "include": ["**/*.ts", "**/*.tsx"],
    "rules": {
      "exclude": ["no-explicit-any"],
      "include": ["no-console", "camelcase"],
      "tags": ["recommended"]
    }
  },
  "lock": false,
  "tasks": {
    "bench": "deno bench --allow-all --no-check benchmarks/",
    "bench:pg": "DISC_PG_AUTO=1 deno bench --allow-all --no-check benchmarks/",
    "build": "deno run --allow-all --no-check cli/main.ts build",
    "build:darwin-arm64": "deno run --allow-all --no-check cli/main.ts build --platform darwin-arm64",
    "build:darwin-x64": "deno run --allow-all --no-check cli/main.ts build --platform darwin-x64",
    "build:linux-arm64": "deno run --allow-all --no-check cli/main.ts build --platform linux-arm64",
    "build:linux-x64": "deno run --allow-all --no-check cli/main.ts build --platform linux-x64",
    "check": "deno task lint && deno task fmt --check && deno task test",
    "cli": "deno run --allow-all --no-check cli/main.ts",
    "dev": "deno run --watch --allow-all --no-check cli/main.ts",
    "docker:build": "docker build -t disc .",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "deno lint",
    "serve": "deno run --allow-net --allow-read --allow-env server/server.ts",
    "test": "deno test --allow-env --allow-net --allow-read --allow-write --no-check",
    "test:all": "DISC_PG_AUTO=1 deno test --allow-all --no-check --ignore=ui/",
    "test:pg": "DISC_PG_AUTO=1 deno test --allow-all --no-check --ignore=ui/"
  },
  "test": {
    "exclude": ["reference-gel/**"],
    "include": ["**/*.test.ts", "tests/**/*.ts"]
  },
  "version": "2026.05.04"
}
